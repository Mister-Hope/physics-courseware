{
  "name": "physics-courseware",
  "version": "1.0.0",
  "private": true,
  "description": "高中物理交互式课件 — monorepo",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:all": "unrun scripts/build-all.ts",
    "dev": "vite",
    "dev:capacitor": "pnpm --filter capacitor-courseware dev",
    "lint": "oxlint --fix && oxfmt"
  },
  "devDependencies": {
    "@mr-hope/tsconfig": "0.0.4",
    "oxc-config-hope": "0.3.15",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "unrun": "^0.3.1",
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.18.0",
      "onFail": "error"
    }
  }
}
